FROM golang:1.25.5-alpine AS builder

ARG TARGETOS=linux
ARG TARGETARCH

ENV GOPROXY=https://goproxy.cn,direct

WORKDIR /workspace

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd/ cmd/
COPY pkg/ pkg/
COPY internal/ internal/
COPY api/ api/
COPY pb/ pb/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-s -w" -o agentd ./cmd/agentd

FROM debian:bookworm-slim

ARG DEBIAN_MIRROR=http://deb.debian.org

RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      bash \
      chromium \
      curl \
      git \
      jq \
      openssh-client \
      procps \
      python3 \
      python3-pip \
      ripgrep \
      tini \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm config set fund false \
    && npm config set audit false \
    && npm install -g agent-browser \
    && npm cache clean --force

WORKDIR /app

COPY --from=builder /workspace/agentd /app/agentd
COPY skills/ /app/skills/
COPY docker/entrypoint.agentd.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV AL_AGENTD_WORKSPACE_ROOT=/workspace \
    AL_AGENTD_SKILLS_DIR=/app/skills \
    AL_AGENTD_MCP_CONFIG_PATHS=/etc/agentland/mcp.json,/workspace/.agentland/mcp.json \
    AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

EXPOSE 1883

ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
CMD ["--port=1883"]
