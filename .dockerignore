# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!api/
!cmd/
!internal/
!pb/
!pkg/
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include embedded helper scripts required by go:embed
!pkg/korokd/handlers/ipykernel_helper.py

# Re-include runtime entrypoint scripts used by Dockerfiles
!docker/
!docker/entrypoint.korokd.sh
!docker/entrypoint.agentd.sh

# Re-include skills bundled with agentd
!skills/
!skills/**
